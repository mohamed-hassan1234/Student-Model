APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=devmind_local
MONGODB_TEST_DATABASE=devmind_test
MONGODB_CONNECT_TIMEOUT_MS=2000
LOG_LEVEL=INFO
WORKER_ENABLED=false
LOCAL_MODEL_PROVIDER=mock
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=mock-devmind-local
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=mock-embedding
EMBEDDING_DIMENSIONS=16
VECTOR_SEARCH_PROVIDER=mock
MODEL_PROVIDER_TIMEOUT_SECONDS=20
LEARNING_CYCLE_MAX_EXAMPLES=20
LEARNING_CYCLE_MAX_PROVIDER_CALLS=40
TEACHER_PROVIDER=mock
TEACHER_MODEL_NAME=mock-devmind-teacher
SAFE_CODE_RUNNER_ENABLED=false
TRAINING_ARTIFACT_DIRECTORY=storage/generated/training
TRAINING_MAX_RUNTIME_MINUTES=60
TRAINING_ALLOW_REMOTE_CODE=false
TRAINING_DEFAULT_SEED=7
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=5242880
MAX_WEB_FETCH_BYTES=2097152
MAX_WEB_REDIRECTS=3
STORAGE_DIRECTORY=storage
